[Unit]
Description=短剧索引定时更新（累计抓取 + 静态发布）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ⚠️ 按服务器实际路径与用户调整（此处以 /var/www/ManhuaDrama、用户 xclikee 为例）
User=xclikee
# 关键：让 python 能找到用户级安装的 httpx（在 ~/.local 里）
Environment=HOME=/home/xclikee
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 每次每平台抓 50 条（配合轮换跳过已抓 URL）。systemd Environment 值含空格必须用引号包裹，
# 否则会被拆成两个变量，导致脚本只收到 --limit 而丢失数值、build_site.py 报 expected one argument。
Environment="DRAMA_EXTRA_ARGS=--limit 50"
WorkingDirectory=/var/www/ManhuaDrama
ExecStart=/var/www/ManhuaDrama/scripts/cron_update.sh
# 每6小时一轮、每站50条，限速 1-3 秒/请求；留足超时余量
TimeoutStartSec=1800
# 可选：成功后 git 推送（需在服务器上配好免密）
Environment=DRAMA_GIT_PUSH=1
Environment=DRAMA_GIT_BRANCH=main

[Install]
WantedBy=multi-user.target

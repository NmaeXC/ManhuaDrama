[Unit]
Description=短剧索引定时更新（累计抓取 + 静态发布）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ⚠️ 按服务器实际路径与用户调整（此处以 /var/www/ManhuaDrama、用户 xclikee 为例）
User=xclikee
# 关键：让 python 能找到用户级安装的 httpx（在 ~/.local 里）
Environment=HOME=/home/xclikee
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 减少每次抓取量：累计池跨轮次累积，每平台抓 30 条即可，避免同步模式下抓 200+ 条耗时过久
Environment=DRAMA_EXTRA_ARGS=--limit 30
WorkingDirectory=/var/www/ManhuaDrama
ExecStart=/var/www/ManhuaDrama/scripts/cron_update.sh
# 抓取限速；同步模式 + 30 条约 1-3 分钟，留足超时余量
TimeoutStartSec=900
# 可选：成功后 git 推送（需在服务器上配好免密）
Environment=DRAMA_GIT_PUSH=1
Environment=DRAMA_GIT_BRANCH=main

[Install]
WantedBy=multi-user.target

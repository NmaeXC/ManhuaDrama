# Ubuntu crontab 定时配置示例
# ------------------------------------------------------------------
# 安装步骤：
#   1) 把本项目放到固定目录，例如 /opt/drama-search（下面按此路径举例）
#   2) 给脚本执行权限：chmod +x /opt/drama-search/scripts/cron_update.sh
#   3) 编辑 crontab：crontab -e
#   4) 复制下面【实际生效行】到 crontab，按你的真实路径替换 /opt/drama-search
#   5) 保存后可用 `crontab -l` 查看，`tail -f /opt/drama-search/log/cron_$(date +%Y%m%d).log` 观察日志
#
# 注意：crontab 里 % 需要转义为 \%，且 command 请用绝对路径。

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 每 6 小时更新一次（00:10 / 06:10 / 12:10 / 18:10；配合每次 50 条轮换抓取）
10 0,6,12,18 * * * /opt/drama-search/scripts/cron_update.sh >> /opt/drama-search/log/crontab_stdout.log 2>&1

# —— 可选变体：按需取消注释其中一行，并注释掉上面那行 ——
# 每天凌晨 2:10 更新一次：
# 10 2 * * * /opt/drama-search/scripts/cron_update.sh >> /opt/drama-search/log/crontab_stdout.log 2>&1
#
# 不联网、仅从累计池重建（适合网络受限服务器，数据不会新增）：
# 10 2 * * * DRAMA_EXTRA_ARGS="--offline" /opt/drama-search/scripts/cron_update.sh >> /opt/drama-search/log/crontab_stdout.log 2>&1
#
# 构建成功后自动 git 提交并推送（静态托管用，需先在服务器上配好 git 凭据）：
# 10 2 * * * DRAMA_GIT_PUSH=1 DRAMA_GIT_BRANCH=main /opt/drama-search/scripts/cron_update.sh >> /opt/drama-search/log/crontab_stdout.log 2>&1

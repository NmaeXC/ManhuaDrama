[Unit]
Description=每 6 小时定时更新短剧索引

[Timer]
# 按真实部署路径替换 /opt/drama-search 对应的 service
Unit=drama-update.service
# 每 6 小时一次（00:10 / 06:10 / 12:10 / 18:10）
OnCalendar=*-*-* 00,06,12,18:10:00
# 若服务器开机时已过点（如重启），补跑一次
Persistent=true
# 随机延迟 0-120 秒，避免多机同刻拥塞目标站
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
